{
  "name": "json-match-lang",
  "version": "0.0.1",
  "description": "Parser for a language designed to match items in json files.",
  "exports": {
     ".": {
      "import": {
        "types": "./dist/esm/main.d.ts",
        "default": "./dist/esm/main.js"
      },
      "require": {
        "types": "./dist/cjs/main.d.ts",
        "default": "./dist/cjs/main.js"
      }
    }
  },
  "type": "module",
  "files": [
    "./dist"
  ],
  "scripts": {
    "clean": "rimraf --glob ./dist/**",
    "cleantemp": "rimraf --glob ./temp/**",
    "make_dist": "node ./scripts/makedist.js",
    "build": "npm run clean && npm run make_dist && tsc -p ./tsconfig.esm.release.json && tsc -p ./tsconfig.cjs.release.json",
    "test": "npm run cleantemp && tsc -p ./tsconfig.test.json && node ./temp/tests/main.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Galbatrollix/json-match-lang.git"
  },
  "keywords": [],
  "author": "Galbatrollix",
  "license": "Unlicense",
  "bugs": {
    "url": "https://github.com/Galbatrollix/json-match-lang/issues"
  },
  "homepage": "https://github.com/Galbatrollix/json-match-lang#readme",
  "devDependencies": {
    "typescript": "^7.0.2",
    "rimraf": "^6.0.1"
  }
}
